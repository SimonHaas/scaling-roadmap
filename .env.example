# Postgres (Neon). The app creates and uses an isolated `roadmap` schema.
DATABASE_URL=

# Evidence review. Tried in this order; if none work the deterministic
# rules gate still runs and the app keeps working.
OPENROUTER_API_KEY=
REVIEW_MODEL=anthropic/claude-sonnet-4.5
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_REVIEW_MODEL=gemini-2.5-flash

# Only for running a production build over http on localhost. Never set in prod.
# COOKIE_INSECURE=1
